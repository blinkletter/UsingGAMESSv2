!   Benzene, D6h symmetry. Unique atoms on the x-axis, ring in the xy-plane
 $CONTRL SCFTYP=RHF RUNTYP=OPTIMIZE MAXIT=30 MULT=1 MOLPLT=.TRUE. $END
 $SYSTEM TIMLIM=525600 MEMORY=20000000 $END
 $BASIS GBASIS=N21 NGAUSS=3 $END
 $SCF DIRSCF=.TRUE. $END
 $STATPT OPTTOL=0.0001 NSTEP=100 $END
 $DATA 
Benzene D6h
DNH 6

C     6.0     1.3900000000   0.0000000000   0.0000000000
H     1.0     2.4700000000   0.0000000000   0.0000000000
 $END
